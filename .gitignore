# Confs de DOSBox generados por los scripts launch_game_*.sh
net-test/generated-*.conf

# Directorio de trabajo de cada instancia. Cada una corre desde el suyo para
# que sus GAME.LOG no se pisen: el juego escribe el log con una ruta
# relativa, asi que dos instancias en la misma carpeta se lo sobreescriben.
# Dentro solo hay una copia de GAME.EXE y el log, ambos regenerados en cada
# lanzamiento.
# Los nombres tienen que caber en el 8.3 de DOS (8 caracteres, sin punto):
# run-server se convertia en RUN-SE~1 y el "cd" del autoexec dejaba de
# encontrarlo.
runserv/
runcli/
runlocal/

# Logs del juego
*.LOG
*.log
!error.log

# Restos de los confs escritos a mano, ya sustituidos por los generados
net-test/log-*/
