# ===========================================================
# Makefile maestro del curso.
#
#   make            compila TODOS los capitulos
#   make clean      borra todos los .exe y .obj
#
# Cada chapNN.exe se queda en la carpeta de su capitulo, no aqui, para que
# puedas entrar, ejecutarlo y estudiarlo por separado:
#
#   cd ch07
#   chap07
#
# El trabajo lo hacen makeall.bat y cleanall.bat, y no se hace directamente
# aqui por un motivo de DOS: un "cd" lanzado desde MAKE se ejecuta en un
# COMMAND.COM hijo y se pierde al volver, asi que MAKE nunca llega a entrar
# en la carpeta. En un fichero .bat el cd si persiste.
#
# Tambien puedes compilar uno suelto:
#
#   makeall 07
# ===========================================================

all:
	makeall.bat

clean:
	cleanall.bat
